{
  "name": "dumply-squirrel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'if command -v node >/dev/null 2>&1; then vite \"$@\"; else bunx --bun vite \"$@\"; fi' --",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
