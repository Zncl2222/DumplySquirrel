# PostgreSQL config database
DB_PASSWORD=change_me_in_production

# Backend auth
JWT_SECRET=change_me_in_production
JWT_TTL_SECONDS=28800
MAX_CONCURRENT_BACKUPS=2
CORS_ALLOWED_ORIGIN=

# SMTP sender account for backup result email notifications.
# If these are empty, backups still run and notification attempts are logged as warnings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

# Docker Compose backup storage on the host.
# Set this to any host path where completed backup files should be stored.
# Examples: ./backups, /mnt/storage/dumply/backups, /srv/backups
BACKUP_STORAGE_PATH=./backups

# Field encryption for target database URLs
DATABASE_ENCRYPTION_KEY=change_me_in_production_32_bytes_minimum

# Host dev backend; used when running `cargo run` directly from ./backend.
# Keep the password literal here because dotenv files do not expand ${DB_PASSWORD}.
DATABASE_URL=postgres://dumply:change_me_in_production@127.0.0.1:5432/dumply_squirrel_dev
BIND_ADDR=127.0.0.1:8000
BACKUP_DIR=../backups-dev

# Bootstrap admin; used only when users table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Frontend / Nginx
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_TLS=false
TLS_CERT_DIR=./certs

# Local dev stack
DEV_DB_NAME=dumply_squirrel_dev
DEV_POSTGRES_PORT=5432
DEV_BACKEND_PORT=8000
DEV_FRONTEND_PORT=5173
DEV_FRONTEND_API_BASE_URL=/api
DEV_FRONTEND_PROXY_TARGET=http://backend:8000
DEV_LOCAL_FRONTEND_PROXY_TARGET=http://127.0.0.1:8000
DEV_CORS_ALLOWED_ORIGIN=
DEV_BACKUP_DIR=./backups-dev
DEV_BACKUP_STORAGE_PATH=./backups-dev
DEV_RUST_LOG=debug
DEV_CHOKIDAR_USEPOLLING=true

RUST_LOG=info
